{
  "name": "apartment-booking-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File dev/run-backend.ps1",
    "backend:mac": "bash dev/run-backend.sh",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "api:types": "npx --yes openapi-typescript@7 http://localhost:5278/openapi/v1.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
