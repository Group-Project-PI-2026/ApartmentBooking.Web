{
  "realm": "apartment-booking",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["uk", "en"],
  "defaultLocale": "uk",
  "roles": {
    "realm": [
      {
        "name": "tenant"
      },
      {
        "name": "owner"
      },
      {
        "name": "manager"
      },
      {
        "name": "admin"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-apartment-booking",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "tenant"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-apartment-booking"
  },
  "clients": [
    {
      "clientId": "apartment-booking-spa",
      "name": "MyRent SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "tenant@myrent.local",
      "email": "tenant@myrent.local",
      "firstName": "Тест",
      "lastName": "Орендар",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-apartment-booking", "tenant"]
    },
    {
      "username": "owner@myrent.local",
      "email": "owner@myrent.local",
      "firstName": "Тест",
      "lastName": "Власник",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-apartment-booking", "owner"]
    },
    {
      "username": "manager@myrent.local",
      "email": "manager@myrent.local",
      "firstName": "Тест",
      "lastName": "Менеджер",
      "enabled": true,
